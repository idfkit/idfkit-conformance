! versions-nine-zero-schema-nine-zero-one
!
! EnergyPlus writes the Version object with two components, so the 9.0 release line
! is written 9.0 in every file it produced. The release itself is 9.0.1 and the
! bundled schema directory is keyed 9.0.1. WindowsCalculationEngine below was added
! in 9.0.1 and does not exist in 8.9.0, which is what makes the schema actually
! selected observable in the parse outcome rather than only in a log line.

  Version,9.0;

  Building,
    Conformance,             !- Name
    0.0,                     !- North Axis {deg}
    City,                    !- Terrain
    0.04,                    !- Loads Convergence Tolerance Value {W}
    0.4,                     !- Temperature Convergence Tolerance Value {deltaC}
    FullExterior,            !- Solar Distribution
    25,                      !- Maximum Number of Warmup Days
    6;                       !- Minimum Number of Warmup Days

  GlobalGeometryRules,
    UpperLeftCorner,         !- Starting Vertex Position
    Counterclockwise,        !- Vertex Entry Direction
    Relative,                !- Coordinate System
    Relative,                !- Daylighting Reference Point Coordinate System
    Relative;                !- Rectangular Surface Coordinate System

  WindowsCalculationEngine,
    BuiltInWindowsModel;     !- Windows Engine
