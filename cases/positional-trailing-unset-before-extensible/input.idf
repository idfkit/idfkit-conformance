! An unset fixed field that is followed by an extensible group.
! Schedule:Day:Interval has two fixed fields after the name and then a repeating (Time, Value)
! group. A fixed field left blank here cannot be omitted by an early semicolon, because the
! extensible group occupies every slot after it, so this exercises the other branch of the
! trailing-unset code path: the object ends with data, not with blanks.

  Version,26.1;

  Building,
    Minimal,                 !- Name
    0.0,                     !- North Axis {deg}
    Suburbs,                 !- Terrain
    0.04,                    !- Loads Convergence Tolerance Value {W}
    0.4,                     !- Temperature Convergence Tolerance Value {deltaC}
    FullExterior,            !- Solar Distribution
    25,                      !- Maximum Number of Warmup Days
    6;                       !- Minimum Number of Warmup Days

  GlobalGeometryRules,
    UpperLeftCorner,         !- Starting Vertex Position
    Counterclockwise,        !- Vertex Entry Direction
    Relative,                !- Coordinate System
    Relative,                !- Daylighting Reference Point Coordinate System
    Relative;                !- Rectangular Surface Coordinate System

  Schedule:Day:Interval,
    Both Fixed Fields Blank, !- Name
    ,                        !- Schedule Type Limits Name
    ,                        !- Interpolate to Timestep
    Until: 12:00,            !- Time 1 {hh:mm}
    0.5,                     !- Value Until Time 1
    Until: 24:00,            !- Time 2 {hh:mm}
    1.0;                     !- Value Until Time 2

  Schedule:Day:Interval,
    Interior Field Blank,    !- Name
    ,                        !- Schedule Type Limits Name
    No,                      !- Interpolate to Timestep
    Until: 24:00,            !- Time 1 {hh:mm}
    1.0;                     !- Value Until Time 1
