! Trailing unset fields in an object type that has NO extensible group.
! Two Zone objects carry the same values in the fields they set, and differ only in how they
! leave the rest unset: the first stops early with a semicolon, the second writes every
! remaining slot as an explicit blank comma. The oracle emits one identical object for both.

  Version,26.1;

  Building,
    Minimal,                 !- Name
    0.0,                     !- North Axis {deg}
    Suburbs,                 !- Terrain
    0.04,                    !- Loads Convergence Tolerance Value {W}
    0.4,                     !- Temperature Convergence Tolerance Value {deltaC}
    FullExterior,            !- Solar Distribution
    25,                      !- Maximum Number of Warmup Days
    6;                       !- Minimum Number of Warmup Days

  GlobalGeometryRules,
    UpperLeftCorner,         !- Starting Vertex Position
    Counterclockwise,        !- Vertex Entry Direction
    Relative,                !- Coordinate System
    Relative,                !- Daylighting Reference Point Coordinate System
    Relative;                !- Rectangular Surface Coordinate System

  Zone,
    Truncated Zone,          !- Name
    0.0,                     !- Direction of Relative North {deg}
    1.0,                     !- X Origin {m}
    2.0,                     !- Y Origin {m}
    3.0;                     !- Z Origin {m}

  Zone,
    Blank Zone,              !- Name
    0.0,                     !- Direction of Relative North {deg}
    1.0,                     !- X Origin {m}
    2.0,                     !- Y Origin {m}
    3.0,                     !- Z Origin {m}
    ,                        !- Type
    ,                        !- Multiplier
    ,                        !- Ceiling Height {m}
    ,                        !- Volume {m3}
    ,                        !- Floor Area {m2}
    ,                        !- Zone Inside Convection Algorithm
    ,                        !- Zone Outside Convection Algorithm
    ;                        !- Part of Total Floor Area
